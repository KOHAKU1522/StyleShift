# このファイルはコミットしてOK（実際の値は入れない）。
# 実運用では .env（gitignore済み）と Netlify の環境変数に本物の値を設定する。

# --- Firebase（ブラウザで使う公開設定。VITE_ を付ける）---
VITE_API_KEY=your-firebase-web-api-key
VITE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_PROJECT_ID=your-project-id
VITE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_MESSAGING_SENDER_ID=000000000000
VITE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Gemini（秘密。VITE_ を付けない。Netlify Function からのみ参照）---
GEMINI_API_KEY=your-gemini-api-key
